PORT=3001
# Ejecucion local: localhost:5433; Docker usa AUTH_DATABASE_URL de la raiz.
# Supabase: Session pooler con el rol de autenticacion.
DATABASE_URL=
DB_SCHEMA=autenticacion
INTERNAL_API_KEY=
# Reservado para HU-05.
JWT_SECRET=
PERSONAL_SERVICE_URL=http://localhost:3002

# Supabase: certificado CA en PEM; omitir sslmode en DATABASE_URL.
DB_SSL_CA_FILE=
DB_POOL_MAX=5
