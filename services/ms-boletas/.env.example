PORT=3005
# Ejecucion local: localhost:5433; Docker usa BOLETAS_DATABASE_URL de la raiz.
# Supabase: Session pooler con el rol de boletas.
DATABASE_URL=
DB_SCHEMA=boletas
INTERNAL_API_KEY=
PERSONAL_SERVICE_URL=http://localhost:3002
GOTENBERG_URL=http://localhost:3000

# Supabase: certificado CA en PEM; omitir sslmode en DATABASE_URL.
DB_SSL_CA_FILE=
DB_POOL_MAX=5
