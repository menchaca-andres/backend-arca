PORT=3002
# Ejecucion local: localhost:5433; Docker usa PERSONAL_DATABASE_URL de la raiz.
# Supabase: Session pooler con el rol de personal.
DATABASE_URL=
DB_SCHEMA=personal
INTERNAL_API_KEY=
AUTH_SERVICE_URL=http://localhost:3001

# Supabase: certificado CA en PEM; omitir sslmode en DATABASE_URL.
DB_SSL_CA_FILE=
DB_POOL_MAX=5
