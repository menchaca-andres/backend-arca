# Copiar a .env.supabase.runtime (ignorado por Git). No incluir la credencial administrativa.
# URLs de Session Pooler: postgresql://<rol>.<project-ref>:<clave>@<host>:5432/postgres
# TLS se configura con DB_SSL_CA_FILE; no agregar sslmode a estas URLs.
INTERNAL_API_KEY=
GATEWAY_DATABASE_URL=
AUTH_DATABASE_URL=
PERSONAL_DATABASE_URL=
VACACIONES_DATABASE_URL=
CONTRATOS_DATABASE_URL=
BOLETAS_DATABASE_URL=

# Puerto libre del frontend de ARCA en el modo Supabase.
FRONTEND_PORT=5174
