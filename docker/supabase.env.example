# Referencia SIN secretos. Copiar a .env.supabase en la raiz.
# .env.supabase ya queda ignorado por Git. No compartirlo.
# Usar el proyecto ARCA del equipo, Connect > Session pooler.
SUPABASE_POOLER_HOST=
SUPABASE_PROJECT_REF=
SUPABASE_ADMIN_PASSWORD=
# Certificado CA descargado desde los ajustes de BD; ruta relativa o absoluta.
SUPABASE_SSL_CA_FILE=
# Passwords nuevas, diferentes, de al menos 24 caracteres.
# Si los roles ya existen, usar sus passwords vigentes: el bootstrap NO las rota.
GATEWAY_DB_PASSWORD=
AUTH_DB_PASSWORD=
PERSONAL_DB_PASSWORD=
VACACIONES_DB_PASSWORD=
CONTRATOS_DB_PASSWORD=
BOLETAS_DB_PASSWORD=
