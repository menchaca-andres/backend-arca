DB_SCHEMA=auditoria
# Reservado para HU-05; no se implementa JWT en HU-03.
JWT_SECRET=
INTERNAL_API_KEY=
AUTH_SERVICE_URL=http://localhost:3001
PERSONAL_SERVICE_URL=http://localhost:3002
VACACIONES_SERVICE_URL=http://localhost:3003
CONTRATOS_SERVICE_URL=http://localhost:3004
BOLETAS_SERVICE_URL=http://localhost:3005
