PORT=8080
# Ejecucion local: usar localhost:5433; Docker usa GATEWAY_DATABASE_URL de la raiz.
# Supabase: usar Session pooler con el rol del schema auditoria.
DATABASE_URL=
DB_SCHEMA=auditoria
# Clave del JWT; debe ser la misma que la de ms-auth.
JWT_SECRET=
# Misma clave interna que los servicios (la usa el dashboard en /internal/stats).
INTERNAL_API_KEY=
AUTH_SERVICE_URL=http://localhost:3001
PERSONAL_SERVICE_URL=http://localhost:3002
VACACIONES_SERVICE_URL=http://localhost:3003
CONTRATOS_SERVICE_URL=http://localhost:3004
BOLETAS_SERVICE_URL=http://localhost:3005
# Origenes del frontend separados por coma (Vite dev en 5173, Docker en 3000).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

# Supabase: certificado CA en PEM; omitir sslmode en DATABASE_URL.
DB_SSL_CA_FILE=
DB_POOL_MAX=5
