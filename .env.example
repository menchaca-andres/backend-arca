# Copiar a .env. Compose lee este archivo desde la raiz; no subir el .env.
# Completar con valores propios. Codificar caracteres especiales de la URL.
POSTGRES_PASSWORD=
# URLs desde los contenedores. Local: postgres://<rol>:<password>@db:5432/arca
# Supabase: usar Session pooler y el rol correspondiente a cada schema.
GATEWAY_DATABASE_URL=
AUTH_DATABASE_URL=
PERSONAL_DATABASE_URL=
VACACIONES_DATABASE_URL=
CONTRATOS_DATABASE_URL=
BOLETAS_DATABASE_URL=
# Misma clave para todas las llamadas internas. Generar una clave propia.
INTERNAL_API_KEY=
# Clave para firmar el JWT del login (ms-auth y gateway). Generar una propia.
JWT_SECRET=
